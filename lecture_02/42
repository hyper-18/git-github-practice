a = int(input("enter a:"))
b = int(input("enter b:"))
opt = input("enter operator:")
if opt == "+":
    print(a, "+", b, "=", a+b)
elif opt == "-":
    print(a, "-", b, "=", a-b)
elif opt == "*":
    print(a, "*", b, "=", a*b)
elif opt == "/":
    print(a, "/", b, "=", a/b)
else:
    print("invalid actions")
